\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Proportion of CTA sentences that are repeated versus unique after normalization. A non trivial share of CTA content consists of exact repeats, consistent with reused intro, outro, or sponsor scripts across episodes.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:cta_sentence_repeats}{{3}{10}{Proportion of CTA sentences that are repeated versus unique after normalization. A non trivial share of CTA content consists of exact repeats, consistent with reused intro, outro, or sponsor scripts across episodes}{figure.3}{}}
